# Salin ke .env lalu sesuaikan. JANGAN commit .env (berisi rahasia).

# ==== Aplikasi ====
APP_NAME=DSS Bansos Bontoramba
APP_ENV=development
# Ganti dengan string acak panjang di produksi (mis. hasil `openssl rand -hex 32`)
SECRET_KEY=ubah-ini-dengan-string-acak-panjang-di-produksi
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ==== Database ====
# Default dev lokal: SQLite (tanpa setup apa pun).
DATABASE_URL=sqlite:///./bansos_dss.db
# Untuk Docker/produksi, gunakan PostgreSQL (butuh requirements-postgres.txt):
# DATABASE_URL=postgresql+psycopg2://bansos:bansos@db:5432/bansos_dss

# ==== Artefak model (diisi setelah Fase 2/3/4) ====
INDOBERT_MODEL_PATH=ml/artifacts/indobert
ML_MODEL_PATH=ml/artifacts/classifier.joblib
FUZZY_CONFIG_PATH=config/fuzzy_config.yaml
